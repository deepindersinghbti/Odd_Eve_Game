#!/bin/sh
# Blocks commits whose staged files are not formatted or do not lint.
#
# The dark-theme UI PR reached the integration branch with global.css missing
# the closing brace of its first rule, which made the browser drop the entire
# stylesheet. Prettier catches that class of paste damage as a parse error, so
# it never needs to be found by eye during review.
#
# Enable with `npm install`, or directly:
#   git config core.hooksPath .githooks
set -eu

if git diff --cached --name-only --diff-filter=ACMR -z | grep -qz .; then
  :
else
  exit 0
fi

# Checks the working tree rather than the staged blobs. That is the usual
# trade-off for a dependency-free hook; if partial staging becomes common here,
# swap this for lint-staged.
git diff --cached --name-only --diff-filter=ACMR -z |
  xargs -0 -r npx prettier --ignore-unknown --check --

git diff --cached --name-only --diff-filter=ACMR -z -- '*.js' '*.jsx' |
  xargs -0 -r npx eslint --
